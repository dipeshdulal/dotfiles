# Global Fcitx5 options -- Japanese + Nepali input.
#
# Seeded (copied, not symlinked) into ~/.config/fcitx5 by ./setup.sh, for the
# same save-on-exit reason as ./profile.
#
# One group, one key: Ctrl+Space walks the group's input methods
# (U.S. -> Mozc -> Nepali -> U.S.), matching how macOS/iOS cycle input
# sources. Ctrl+Shift+Space walks back (U.S. -> Nepali -> Mozc).

[Hotkey/TriggerKeys]
# Intentionally EMPTY.
#
# fcitx's built-in default here is Ctrl+Space, and this list is matched
# BEFORE EnumerateForwardKeys below -- leaving it set would swallow the
# chord and fcitx would toggle on/off instead of walking the list. With
# every language in one group the "off" state is just the keyboard-us
# item, so the toggle is redundant and only gets in the way.
#
# Deliberately NOT setting AltTriggerKeys=Shift_L (a common preference for
# toggling on a bare left Shift). binds-user.lua uses Shift+Home +
# BackSpace for Super+Backspace line editing, and a bare-Shift IME trigger
# would fight it.

[Hotkey/AltTriggerKeys]

[Hotkey/EnumerateForwardKeys]
# Walk to the next input method in the group: U.S. -> Mozc -> Nepali -> U.S.
# Hyprland does not bind Ctrl+Space, so fcitx receives the chord directly
# (Super+Space is DMS spotlight and Alt+Space is DMS spotlight-bar, but
# Ctrl+Space is free -- verified with `hyprctl binds -j`). This is macOS's
# Ctrl+Space.
#
# SPELLING MATTERS. Fcitx's key parser (fcitx-utils/key.cpp) only recognises
# "Control+" / "CTRL_", "Shift+" / "SHIFT_", "Super+" / "SUPER_" -- mixed
# case, or all-caps with a trailing underscore. There is no "CTRL+" form:
# "CTRL+space" matches no modifier, fails to resolve as a key, and is stored
# as an *empty* binding, silently disabling the shortcut. (This file used to
# say CTRL+space and CTRL+SHIFT+space, which is why neither key did anything.)
0=Control+space

[Hotkey/EnumerateBackwardKeys]
# Walk back: U.S. -> Nepali -> Mozc. Reuses the chord the old two-group
# setup spent on group switching.
0=Control+Shift+space

[Hotkey/EnumerateGroupForwardKeys]

[Hotkey/EnumerateGroupBackwardKeys]
# Both empty: there is only one group, so there is nothing to switch
# between. (Fcitx's built-in default for the forward key is Super+Space,
# which DMS spotlight already owns; leaving it here would be dead weight.)

[Behavior]
# Show which IM is active and its mode, so there is a visible cue for
# Japanese vs. Nepali vs. direct input beyond the candidate window.
ShowInputMethodInformation=True
CompactInputMethodInformation=True
DefaultPageSize=5

# Never run the IME in password fields: without this a half-typed romaji
# preedit can be committed into a password prompt.
AllowInputMethodForPassword=False
