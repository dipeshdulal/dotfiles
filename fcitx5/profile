# Fcitx5 group configuration -- Japanese + Nepali input.
#
# Seeded (copied, not symlinked) into ~/.config/fcitx5 by ./setup.sh.
# Fcitx5 rewrites this file when it exits, so symlinking it into the
# dotfiles repo would leave it permanently dirty.
#
# ONE group holds every language, so a single Ctrl+Space walks the whole
# list -- U.S. -> Mozc (Japanese) -> ne-rom (Nepali) -> U.S. -- the way
# macOS/iOS cycle input sources. There are no per-language groups and no
# IME on/off toggle: the "U.S." item *is* the off state. See ./config for
# the keys.
#
# The group sets "Default Layout=us", required even for Nepali: m17n's
# ne-rom maps the ASCII keys of a US layout to Devanagari (k=क, a=ा, Q=ठ,
# ...), so it needs plain US keysyms, not a Devanagari keymap.
#
# Item order is the walk order, so it matters. Index 0 must be the
# direct/ASCII keyboard layout: Instance::inputMethod() falls back to
# inputMethodList()[0] whenever the IME is inactive, and enumerate() uses
# that to decide the next entry when the list wraps.

[Groups/0]
Name=Default
# The XKB layout fcitx switches to. Matches input.kb_layout in
# hyprland.lua (which inherits XKB_DEFAULT_LAYOUT = us).
Default Layout=us
DefaultIM=keyboard-us

[Groups/0/Items/0]
Name=keyboard-us

[Groups/0/Items/1]
Name=mozc

[Groups/0/Items/2]
# Nepali, from fcitx5-m17n + m17n-db (both official repos). "ne-rom" is the
# romanized *keyboard layout* published by MPP (Madan Puraskar Pustakalaya):
# a fixed one-key-one-glyph map, NOT a transliteration. k a Q m a x w M
# gives काठमाडौं. fcitx5-m17n names entries "m17n_<lang>_<name>"
# (im/engine.cpp), hence m17n_ne_rom.
#
# Other Nepali engines m17n-db ships, if you ever want to swap the item:
#   m17n_ne_rom_translit  Google-style transliteration (type roman words)
#   m17n_ne_trad          MPP traditional layout
#   m17n_ne_trad_ttf      MPP traditional, typewriter variant
Name=m17n_ne_rom

[GroupOrder]
0=Default
